# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅 → 加密策略里配置的 Verification Token / Encrypt Key（若开启加密再填 ENCRYPT_KEY）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 复用 luckin CLI 已验证可用的模型（见 ~/.luckin/.env / ~/.luckin/config.json）
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7-highspeed
LLM_API_KEY=

# 瑞幸点单 MCP（Streamable HTTP），token 与 luckin 共用同一个登录态
LUCKIN_MCP_URL=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_MCP_ORDER_TOKEN=

# 高德官方地图 MCP（可选；用于“某地点附近最近的瑞幸”语义）
# 在高德开放平台申请 MCP Key：https://developer.amap.com/api/mcp-server/gettingstarted
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MAPS_API_KEY=

PORT=3000
